# Terraform reads TF_VAR_<name> as the value of variable "<name>".
# Load before running terraform (from tools/terraform/aws):
#   set -a; source ../../.env; set +a

# AWS credentials
TF_VAR_aws_access_key=
TF_VAR_aws_secret_key=

# Name of an existing EC2 key pair, used for SSH into the instances
TF_VAR_key_name=

# Your public IP in CIDR form, e.g. 203.0.113.10/32 (SSH and Jenkins UI are limited to it)
TF_VAR_my_ip=

# Password for the Jenkins "admin" user
TF_VAR_jenkins_admin_password=

# HTTPS: token from duckdns.org, and an optional email for the Let's Encrypt account
TF_VAR_duckdns_token=
TF_VAR_letsencrypt_email=

# true while testing: untrusted certificate, but no Let's Encrypt limit of 5 per week
TF_VAR_letsencrypt_staging=false
